    <ItemGroup>
      <Reference Include="System.Net.Primitives">
        <HintPath>..\..\..\.dotnet\packs\Microsoft.NETCore.App.Ref\8.0.13\ref\net8.0\System.Net.Primitives.dll</HintPath>
